# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
build/
*.tgz

# 日志
*.log
npm-debug.log*
yarn-error.log*

# 编辑器
.vscode/
.idea/
*.swp
*.swo

# 系统
.DS_Store
Thumbs.db

# ── 运行数据（绝不入库）──────────────────────────────────────
# 插件运行期产生的数据目录：团队库、手册、缓存、备份都在这里。
# 仓库是公开的，这些文件含本机路径、真实任务内容、会话 id，
# 一旦提交就等同于把用户工作数据公开。
data/
plugin-data/
备份/
backups/
_备份/

# 数据库（含 WAL/SHM 附属文件）
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# 会话与日志转储
sessions/
transcripts/
*.ndjson

# 本机配置覆盖
.env
.env.*
*.local
route-config.local.json

# 临时脚本与草稿
_临时/
_scratch/
*.bak
*.bak-*
*.orig
*.rej

# 修 bug 时留下的文件副本（如 index.js.fixed-task_xxx）
*.fixed-*
*.old
*.copy
*.tmp

# 运行期探测输出与工具日志（不是源码）
run/
.memsearch/

# 本机路由/窗口探测结果（含本机 provider 与倍率快照）
route-config.json
capability-probe.json
*probe*.json
*probe*.json
window-*.json
