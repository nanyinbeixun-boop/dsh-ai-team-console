#!/bin/sh
# pre-commit：提交前扫暂存区，有高危命中直接拒绝
#
# 安装（仓库根目录跑一次）：
#   git config core.hooksPath .githooks
#
# 跳过（确知本次提交无敏感内容时）：
#   git commit --no-verify
#
# 规则与豁免见 SECURITY.md。

echo "[pre-commit] 扫描暂存区敏感信息..."

# ── 定位 node：git 执行钩子时的 PATH 往往不含用户级安装 ──────────
NODE_BIN=""
for cand in node node.exe node.cmd; do
  if command -v "$cand" >/dev/null 2>&1; then NODE_BIN="$cand"; break; fi
done

# 常见安装位置（Windows，从远端安装或商店安装都可能不在 PATH）
if [ -z "$NODE_BIN" ]; then
  for cand in \
    "$LOCALAPPDATA/Programs/node/node.exe" \
    "/c/Program Files/nodejs/node.exe" \
    "/c/Program Files (x86)/nodejs/node.exe" \
    "$APPDATA/npm/node.exe" \
    "$APPDATA/dsh-desktop/harness/.desktop-bin/node.cmd" \
    "$HOME/AppData/Roaming/dsh-desktop/harness/.desktop-bin/node.cmd"
  do
    if [ -x "$cand" ] || [ -f "$cand" ]; then NODE_BIN="$cand"; break; fi
  done
fi

if [ -z "$NODE_BIN" ]; then
  cat >&2 <<'EOF'
[pre-commit] 跳过扫描：未找到 node

扫描脚本需要 Node.js。请任选其一：
  1. 把 node 加入 PATH
  2. 设环境变量 DSH_NODE 指向 node 可执行文件：
       setx DSH_NODE "C:\path\to\node.exe"
  3. 临时跳过本次检查：git commit --no-verify

注意：跳过等于放弃提交前防护，推送前请手动跑：
       node scripts/scan-secrets.mjs
EOF
  exit 0
fi

# 允许用 DSH_NODE 显式指定
if [ -n "$DSH_NODE" ] && [ -f "$DSH_NODE" ]; then
  NODE_BIN="$DSH_NODE"
fi

echo "[pre-commit] node: $NODE_BIN"

"$NODE_BIN" scripts/scan-secrets.mjs --staged
status=$?

if [ $status -ne 0 ]; then
  cat >&2 <<'EOF'

────────────────────────────────────────────────────────────
[pre-commit] 提交被拒绝：暂存区含敏感信息

按 SECURITY.md 处理：
  1. 凭据：先到平台撤销/轮换，再清历史
  2. 网络/账号：把文件移出仓库并加入 .gitignore
  3. 确属误报（示例值）：把该值加进 SECURITY.md 的白名单说明，
     或在 scripts/scan-secrets.mjs 的 ALLOWLIST 里补规则

确知本次提交无敏感内容时可用：git commit --no-verify
────────────────────────────────────────────────────────────
EOF
  exit 1
fi

echo "[pre-commit] 通过"
exit 0
